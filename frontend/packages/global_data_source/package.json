{
	"name": "@river-dash/global-data-source",
	"version": "1.0.0",
	"description": "RiverDash Global Data Source",
	"author": "RiverDash Contributors",
	"type": "module",
	"exports": {
		".": "./dist/global_data_table.js",
		"./global_data_table": "./dist/global_data_table.js",
		"./types": "./dist/types.js",
		"./topic": "./dist/topic.js",
		"./network_stream": "./dist/network_stream.js",
		"./network_serialize": "./dist/network_serialize.js"
	},
	"scripts": {
		"test": "vitest run --dir src",
		"build": "tsc -b",
		"dev": "npx nodemon --ext 'js ts json' --watch 'src/**' --exec 'npm run build' ",
		"lint": "eslint .",
		"format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}'",
		"doc": "npx typedoc"
	},
	"dependencies": {
		"neverthrow": "^8.2.0",
		"temporal-polyfill": "^1.0.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"dotenv": "^18.0.5",
		"eslint": "^10.10.0",
		"globals": "^17.12.0",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.2",
		"typedoc-plugin-mdn-links": "^5.1.1",
		"typescript-eslint": "^8.69.0",
		"vitest": "^5.0.3"
	},
	"typedocOptions": {
		"plugin": [
			"typedoc-plugin-mdn-links"
		]
	}
}
